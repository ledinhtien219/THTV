<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CarHud" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/carhud_bg</item>
        <item name="android:statusBarColor">@color/carhud_bg</item>
        <item name="android:navigationBarColor">@color/carhud_bg</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.CarHud.Dialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>
</resources>
